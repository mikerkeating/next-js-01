{
  "name": "@repo/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared testing utilities, mock factories, and MSW handlers for the monorepo",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/render.tsx",
    "./providers": "./src/providers.tsx",
    "./types": "./src/types.ts",
    "./mocks": "./src/mocks/index.ts",
    "./mocks/server": "./src/mocks/server.ts",
    "./mocks/handlers": "./src/mocks/handlers.ts",
    "./factories": "./src/factories/index.ts",
    "./factories/user": "./src/factories/user.ts",
    "./factories/organization": "./src/factories/organization.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "msw": "^2.12.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.14"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0",
    "vitest": ">=4.0.0"
  }
}
