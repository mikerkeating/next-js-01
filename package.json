{
  "name": "mk3-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.22.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean",
    "dev:next": "next dev",
    "build:next": "next build",
    "start": "next start",
    "lint:local": "eslint . --max-warnings 0",
    "lint:fix:local": "eslint . --fix",
    "type-check:local": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:local": "echo 'No unit tests configured yet'",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.10.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.6.1",
    "typescript": "^5.7.0"
  }
}
