# Test Database Configuration
#
# Configure this file with your test database connection string.
# The test database should be separate from development/production.
#
# IMPORTANT: This file should NOT be committed with real credentials.
# Copy .env.test.example to .env.test and configure locally.

# =============================================================================
# DATABASE_URL - Primary database connection for the application
# =============================================================================
# This is used by the main database client when running the application.
# For unit tests with mocking, this can be left empty or set to a placeholder.
#
# Local Docker (recommended for development):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
#
# Neon (for cloud testing):
# DATABASE_URL=postgres://user:pass@ep-example.us-east-1.aws.neon.tech/neondb
DATABASE_URL=

# =============================================================================
# DATABASE_URL_TEST - Test database connection (for integration tests)
# =============================================================================
# This is used specifically by integration tests via the test-client.
# Should point to a test database that can be safely modified.
#
# Local Docker example:
# DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/test_db
DATABASE_URL_TEST=

# =============================================================================
# Skip Flags
# =============================================================================
# Skip database integration tests when no test DB is available
# Set to 'true' in CI environments without database access
# Set to 'false' when running integration tests locally with Docker
SKIP_DB_TESTS=true

# Skip database integration tests specifically (alternative flag)
# Used by integration test setup to skip when database is unavailable
SKIP_DB_INTEGRATION_TESTS=true
