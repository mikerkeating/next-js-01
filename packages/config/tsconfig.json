{
  "extends": "./src/typescript/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "vitest/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
