{
  "name": "mk3-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.22.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "test:coverage": "turbo test:coverage",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "reinstall": "pnpm clean && pnpm install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:md:links": "find . -name '*.md' -not -path './node_modules/*' -not -path './.git/*' -not -path './testing/*' | xargs -I {} markdown-link-check {} -c .markdown-link-check.json",
    "check:docs": "pnpm lint:md && pnpm check:readmes && pnpm check:jsdoc",
    "check:readmes": "./scripts/check-package-readmes.sh",
    "check:jsdoc": "./scripts/check-jsdoc-coverage.sh",
    "check:jsdoc:warn": "./scripts/check-jsdoc-coverage.sh --warn-only",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:smoke": "pnpm exec playwright test --project=smoke-chromium --project=smoke-firefox --project=smoke-webkit",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs-aggregates": "node --import tsx scripts/aggregate-package-docs.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix --config .markdownlint-cli2.jsonc",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.34.0",
    "lint-staged": "^16.2.7",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli2": "^0.19.1",
    "prettier": "^3.7.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tsx": "^4.21.0",
    "turbo": "^2.6.1",
    "vitest": "^4.0.14"
  }
}
