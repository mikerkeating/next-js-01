# ===========================================
# MK3 Platform Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
#
# Variables are validated at build time using @t3-oss/env-nextjs
# See src/env.ts for the validation schema

# ===========================================
# Application (Required)
# ===========================================
# The base URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Build Configuration
# ===========================================
# Set to "true" to skip environment validation during CI builds
# SKIP_ENV_VALIDATION=true

# ===========================================
# Database (Optional for Steel Thread)
# ===========================================
# PostgreSQL connection string via Neon/Supabase
# Required in: Epic 2A.2+
# DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================================
# Authentication (Optional for Steel Thread)
# ===========================================
# Clerk authentication keys
# Required in: Epic 2A.7+
# CLERK_SECRET_KEY=sk_test_xxxxx
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
# CLERK_WEBHOOK_SECRET=whsec_xxxxx

# ===========================================
# Analytics (Optional)
# ===========================================
# PostHog product analytics
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# Error Tracking (Optional)
# ===========================================
# Sentry error monitoring
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# ===========================================
# Notifications (Optional)
# ===========================================
# Slack webhook for alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx

# ===========================================
# Basic Auth (Optional - Pre-Release Protection)
# ===========================================
# HTTP Basic Authentication for pre-release deployments
# Auth is DISABLED when these variables are not set (convenient for local dev)
# Set both to enable authentication on protected routes
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=your-secure-password

# ===========================================
# Security (Optional for Steel Thread)
# ===========================================
# AES-256 encryption key (Base64 encoded 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=base64-encoded-32-bytes-key-here

# ===========================================
# Turborepo Remote Caching (CI/CD)
# ===========================================
# Required for CI/CD remote cache. Local developers use `npx turbo login` instead.
# Read https://vercel.com/docs/sign-in-with-vercel/tokens and get token from: https://vercel.com/account/tokens
# TURBO_TOKEN=your-vercel-token
# TURBO_TEAM=your-vercel-team-slug
