{
  "name": "@repo/middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Shared middleware utilities for Next.js applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./basic-auth": {
      "types": "./dist/basic-auth/index.d.ts",
      "import": "./dist/basic-auth/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "pnpm run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@repo/config": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.2.0",
    "next": "^16.0.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^4.0.14"
  },
  "peerDependencies": {
    "next": ">=16.0.0"
  }
}
