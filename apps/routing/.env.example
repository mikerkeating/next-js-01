# =============================================================================
# Environment Variables for @repo/routing
# =============================================================================
# Copy this file to .env.local and fill in the values for local development.
# See env.ts for validation schemas and descriptions.
#
# Required variables have no default and must be set.
# Optional variables can be omitted or left empty.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Node environment (default: development)
# Values: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string (optional for steel thread)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# -----------------------------------------------------------------------------
# Authentication (Clerk)
# -----------------------------------------------------------------------------

# Clerk secret key for server-side operations (optional for steel thread)
# Get from: https://dashboard.clerk.com → API Keys
# CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret for verifying webhook payloads (optional)
# Get from: https://dashboard.clerk.com → Webhooks
# CLERK_WEBHOOK_SECRET=whsec_...

# Clerk publishable key for client-side SDK (optional for steel thread)
# Get from: https://dashboard.clerk.com → API Keys
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# Monitoring & Error Tracking (Sentry)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io → Project Settings → Client Keys
# SENTRY_DSN=https://...@sentry.io/...

# Sentry Organization slug (optional)
# SENTRY_ORG=your-org

# Sentry project slug (optional)
# SENTRY_PROJECT=your-project

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------

# Slack webhook URL for notifications (optional)
# Get from: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Basic authentication for pre-release protection (optional)
# When both are set, routes will require basic auth
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=changeme

# Encryption key for sensitive data (optional)
# Must be exactly 44 characters (base64-encoded 32 bytes)
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=base64-encoded-32-bytes-here==============

# -----------------------------------------------------------------------------
# Analytics (PostHog)
# -----------------------------------------------------------------------------

# PostHog API key for product analytics (optional)
# Get from: https://app.posthog.com → Project Settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_...

# PostHog host URL (optional)
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------

# Public application URL (optional - Vercel provides VERCEL_URL automatically)
# Used for generating absolute URLs
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------

# Skip environment validation during build (optional)
# Set to "true" to skip validation (useful for CI builds without secrets)
# SKIP_ENV_VALIDATION=false
