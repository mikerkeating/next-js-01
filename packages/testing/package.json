{
  "name": "@repo/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared testing utilities, mock factories, and MSW handlers for the monorepo",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/render.tsx",
    "./providers": "./src/providers.tsx",
    "./types": "./src/types.ts",
    "./mocks": "./src/mocks/index.ts",
    "./mocks/server": "./src/mocks/server.ts",
    "./mocks/handlers": "./src/mocks/handlers.ts",
    "./factories": "./src/factories/index.ts",
    "./factories/user": "./src/factories/user.ts",
    "./factories/organization": "./src/factories/organization.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "msw": "^2.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "happy-dom": "^20.0.11",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^4.0.14"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0",
    "vitest": ">=4.0.0"
  }
}
