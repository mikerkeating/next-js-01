{
  "name": "@repo/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared testing utilities, mock factories, and MSW handlers for the monorepo",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks/index.ts",
    "./mocks/server": "./src/mocks/server.ts",
    "./mocks/handlers": "./src/mocks/handlers.ts",
    "./factories": "./src/factories/index.ts",
    "./factories/user": "./src/factories/user.ts",
    "./factories/organization": "./src/factories/Organization.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "msw": "^2.12.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.0.14"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  }
}
