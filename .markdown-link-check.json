{
  "$schema": "https://raw.githubusercontent.com/tcort/markdown-link-check/master/config.schema.json",
  "ignorePatterns": [
    {
      "pattern": "^http://localhost",
      "comment": "Local development URLs"
    },
    {
      "pattern": "^https://localhost",
      "comment": "Local development URLs (HTTPS)"
    },
    {
      "pattern": "^https://example\\.com",
      "comment": "Example domain URLs"
    },
    {
      "pattern": "^http://example\\.com",
      "comment": "Example domain URLs (HTTP)"
    },
    {
      "pattern": "^https://your-org",
      "comment": "Placeholder organization URLs"
    },
    {
      "pattern": "^https://your-",
      "comment": "Placeholder URLs starting with your-"
    },
    {
      "pattern": "^mailto:",
      "comment": "Email links"
    },
    {
      "pattern": "^https://github\\.com/.*/pull/",
      "comment": "GitHub PR links may require authentication"
    },
    {
      "pattern": "^https://github\\.com/.*/issues/",
      "comment": "GitHub issue links may be private"
    },
    {
      "pattern": "^https://.*\\.vercel\\.app",
      "comment": "Vercel preview deployments are temporary"
    },
    {
      "pattern": "\\{\\{.*\\}\\}",
      "comment": "Template variables"
    },
    {
      "pattern": "<.*>",
      "comment": "Placeholder URLs in angle brackets"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "./"
    }
  ],
  "timeout": "10s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "2s",
  "aliveStatusCodes": [
    200,
    206,
    301,
    302,
    307,
    308
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com"],
      "headers": {
        "Accept": "text/html"
      }
    }
  ]
}