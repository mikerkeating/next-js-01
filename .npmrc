# pnpm workspace configuration
# Per ADR-002: pnpm as Package Manager

# Strict dependency resolution
auto-install-peers=false
strict-peer-dependencies=true

# Workspace configuration
link-workspace-packages=true
prefer-workspace-packages=true

# Lockfile settings
lockfile=true
# Prefer frozen lockfile in CI for reproducible installs
# Can be bypassed locally with --no-frozen-lockfile flag
prefer-frozen-lockfile=true

# Performance optimizations
side-effects-cache=true

# Cross-platform script compatibility
# Runs scripts in pnpm's built-in shell emulator for consistent behaviour
# across macOS, Linux, and Windows
shell-emulator=true

# Dependency resolution
# Use 'highest' to get the latest compatible versions during resolution
resolution-mode=highest
