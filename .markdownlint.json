{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,
  "MD003": {
    "style": "atx"
  },
  "MD004": {
    "style": "dash"
  },
  "MD007": {
    "indent": 2
  },
  "MD013": false,
  "MD024": {
    "siblings_only": true
  },
  "MD033": {
    "allowed_elements": [
      "br",
      "details",
      "summary",
      "img",
      "a",
      "sup",
      "sub",
      "kbd",
      "code",
      "pre",
      "div",
      "span",
      "table",
      "thead",
      "tbody",
      "tr",
      "th",
      "td",
      "example",
      "commentary",
      "reasoning",
      "env",
      "system-reminder",
      "ide_selection",
      "antml:function_calls",
      "antml:invoke",
      "antml:parameter",
      "function_results",
      "result",
      "name",
      "output",
      "good-example",
      "bad-example"
    ]
  },
  "MD001": false,
  "MD025": false,
  "MD035": false,
  "MD036": false,
  "MD040": false,
  "MD041": false,
  "MD046": false,
  "MD048": {
    "style": "backtick"
  },
  "MD051": false,
  "MD060": false
}
