{
  "ignorePatterns": [
    {
      "pattern": "^https://github\\.com/.*/pull/",
      "comment": "GitHub PR links may require authentication"
    },
    {
      "pattern": "^https://github\\.com/.*/issues/",
      "comment": "GitHub issue links may be private"
    },
    {
      "pattern": "^https://.*\\.vercel\\.app",
      "comment": "Vercel preview deployments are temporary"
    },
    {
      "pattern": "^http://localhost",
      "comment": "Local development URLs"
    },
    {
      "pattern": "^https://your-org",
      "comment": "Placeholder Organization URLs"
    },
    {
      "pattern": "^https://example\\.com",
      "comment": "Example domain URLs"
    },
    {
      "pattern": "^mailto:",
      "comment": "Email links"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "./"
    }
  ],
  "timeout": "10s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "5s",
  "aliveStatusCodes": [
    200,
    206,
    301,
    302,
    307,
    308
  ]
}